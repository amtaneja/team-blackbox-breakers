# Shared Google Cloud project configuration
GOOGLE_CLOUD_PROJECT=project-c7b154e5-95da-4f50-a5b

# Invoice parser
INVOICE_DOCUMENTAI_LOCATION=us
INVOICE_DOCUMENTAI_PROCESSOR_ID=ea53a2713455dd38
# Optional: defaults to the processor's current default version
INVOICE_DOCUMENTAI_PROCESSOR_VERSION_ID=
# Optional comma-separated list, for example: text,entities,pages.pageNumber
INVOICE_DOCUMENTAI_FIELD_MASK=entities

# Purchase order parser (purchase-order-parser)
PO_DOCUMENTAI_LOCATION=us
PO_DOCUMENTAI_PROCESSOR_ID=48ec6e25c970f7f9
# Optional: defaults to the processor's current default version
PO_DOCUMENTAI_PROCESSOR_VERSION_ID=
# Optional comma-separated list, for example: text,entities,pages.pageNumber
PO_DOCUMENTAI_FIELD_MASK=entities

# Maximum accepted PDF upload size in bytes (20 MiB)
MAX_UPLOAD_SIZE_BYTES=20971520

# Root agent A2A JSON-RPC URL (start app.fast_api_app on port 8081)
ROOT_AGENT_URL=http://127.0.0.1:8081/a2a/app
